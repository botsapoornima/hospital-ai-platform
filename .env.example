# Copy to .env and adjust. None are required for the local demo - sensible defaults are used.

# Port the Express server listens on
PORT=3000

# Secret used to sign JWTs. MUST be changed to a long random value in any real deployment.
JWT_SECRET=dev-only-secret-change-me

# Path to the SQLite database file. Defaults to ./data/platform.db if unset.
# DB_PATH=./data/platform.db

# --- Not used by this prototype, but this is where real credentials would live ---
# A real EHR connector would read its own secrets here, e.g.:
# EHR_API_BASE_URL=
# EHR_API_KEY=
# EHR_CLIENT_ID=
# EHR_CLIENT_SECRET=

# A real voice/telephony vendor would read its own secrets here, e.g.:
# TELEPHONY_ACCOUNT_SID=
# TELEPHONY_AUTH_TOKEN=
# SPEECH_TO_TEXT_API_KEY=
# TEXT_TO_SPEECH_API_KEY=

# No secret should ever be committed to source control. This file is a template only.
